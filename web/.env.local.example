# ============================================================================
# Organizer · variables de entorno
#
# Copia este archivo a `.env.local` (que git ignora) y rellenalo. Las mismas
# seis variables van tambien en Vercel → Project → Settings → Environment
# Variables, y dos de ellas ademas en la Edge Function.
#
# Las tres primeras se usan ya en F0. Las tres ultimas quedan declaradas
# porque el proyecto las necesita despues, y descubrir a mitad de F3 que falta
# una es peor que tenerlas escritas desde hoy. Dejalas vacias hasta entonces.
# Origen de la lista: docs/02-arquitectura.md § Variables de entorno.
# ============================================================================


# ── Supabase ─────────────────────────────────────────────────────────────────

# URL del proyecto. Esta en Project Settings → API → Project URL.
# Publica: viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anonima (`anon` / `publishable`). Misma pantalla.
# Publica POR DISENO: lo que protege los datos es RLS, no el secreto de esta
# clave. Cada tabla de docs/schema.sql filtra por auth.uid().
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (`service_role`). Misma pantalla, seccion de abajo.
#
# SE SALTA RLS. Es la llave maestra de la base de datos.
# Nunca con prefijo NEXT_PUBLIC_, nunca importada desde un componente de
# cliente, nunca pegada en un chat. Solo la usan el endpoint de captura (F1) y
# el despachador de notificaciones (F3), los dos en servidor.
SUPABASE_SERVICE_ROLE_KEY=


# ── Web Push · llega en F3 ───────────────────────────────────────────────────

# Par de claves VAPID. Se generan una vez:  npx web-push generate-vapid-keys
# La publica la usa el navegador para suscribirse.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# La privada firma cada envio. Va en la Edge Function, no en el navegador.
VAPID_PRIVATE_KEY=


# ── Captura por Siri · llega en F1 ───────────────────────────────────────────

# Secreto largo y aleatorio que autentica POST /api/capture. El mismo valor va
# dentro del Atajo del iPhone, en la cabecera Authorization: Bearer <token>.
# Generalo asi:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CAPTURE_TOKEN=
