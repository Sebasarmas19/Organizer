# ============================================================================
# Organizer · Plantilla de variables de entorno
#
# Para desarrollo local:
# Copia este archivo a `web/.env.local` (y a `.env.local` en la raíz si lo deseas).
# Git ignora ambos archivos por seguridad (.gitignore: .env*).
#
# En producción (Vercel):
# Configura estas variables en Vercel → Project Settings → Environment Variables.
# ============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────

# URL del proyecto (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima pública (`anon` / `publishable`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta de servicio (`service_role`).
# IMPORTANTE: Nunca con prefijo NEXT_PUBLIC_, nunca en cliente, nunca en GitHub.
SUPABASE_SERVICE_ROLE_KEY=


# ── Web Push (Notificaciones PWA) ───────────────────────────────────────────

# Par de claves VAPID generables con:
# node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const b=s=>Buffer.from(s,'base64url');const p=publicKey.export({format:'jwk'});console.log('NEXT_PUBLIC_VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),b(p.x),b(p.y)]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+privateKey.export({format:'jwk'}).d)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Correo de contacto RFC 8292 para el servicio Web Push
VAPID_SUBJECT=mailto:tu@correo.com


# ── Captura rápida (Atajos de iOS / Siri) ────────────────────────────────────

# Token secreto para POST /api/capture.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CAPTURE_TOKEN=
